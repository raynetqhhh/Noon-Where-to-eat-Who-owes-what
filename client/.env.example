# Copy to client/.env
# Supabase dashboard -> Project Settings -> API
# Use the anon / publishable key here (safe for the browser). NEVER the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave empty in development: Vite proxies /api to localhost:4000.
# In production, set to your deployed API origin, e.g. https://noon-api.onrender.com
VITE_API_URL=
